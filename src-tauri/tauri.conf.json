{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cool Resume",
  "version": "1.0.0",
  "identifier": "cool.but.resume",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:60090",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cool Resume",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
